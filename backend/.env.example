# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resumejdmatch

# ─── Azure OpenAI ────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_FALLBACK_DEPLOYMENT=

# ── Model profile: pick ONE block, comment out the other ─────────────────────
#
# PROFILE A — gpt-5.4-nano  (fast, ~3-4 min total, lower cost)
# Best for: demos, frequent iterations, cost-sensitive usage
#
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-nano
LLM_MAX_TOKENS_RESUME_PARSER=8000
LLM_MAX_TOKENS_JD_PARSER=3000
LLM_MAX_TOKENS_MATCH_SCORING=2000
LLM_MAX_TOKENS_GAP_ANALYSIS=3000
LLM_MAX_TOKENS_ATS_CHECK=1500
LLM_MAX_TOKENS_RESUME_TAILORING=10000
LLM_MAX_TOKENS_CLAIM_VERIFICATION=5000
LLM_MAX_TOKENS_COVER_LETTER=1500
LLM_MAX_TOKENS_INTERVIEW_PREP=6000
#
# PROFILE B — gpt-5-mini  (reasoning model, ~8-10 min total, higher quality)
# Best for: production, final submissions, best tailoring accuracy
# NOTE: reasoning tokens count against the limit — values are 2x Profile A
#
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
# LLM_MAX_TOKENS_RESUME_PARSER=16000
# LLM_MAX_TOKENS_JD_PARSER=6000
# LLM_MAX_TOKENS_MATCH_SCORING=4000
# LLM_MAX_TOKENS_GAP_ANALYSIS=6000
# LLM_MAX_TOKENS_ATS_CHECK=3000
# LLM_MAX_TOKENS_RESUME_TAILORING=20000
# LLM_MAX_TOKENS_CLAIM_VERIFICATION=10000
# LLM_MAX_TOKENS_COVER_LETTER=3000
# LLM_MAX_TOKENS_INTERVIEW_PREP=12000
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Azure Blob Storage ──────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=resumes

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET_KEY=generate-a-strong-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OAuth Providers ─────────────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-client-id
OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ─── OpenTelemetry ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=resumejdmatch-ai

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ANALYSES_PER_HOUR=10
REDIS_URL=redis://localhost:6379/0

# ─── Email / SMTP ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@resumejdmatch.ai

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
PROMPT_VERSION=v1
SEMANTIC_MAPPINGS_PATH=app/semantic/mappings.yaml
